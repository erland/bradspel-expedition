{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cards.schema.json",
  "title": "Expedition cards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "decks",
    "cards"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "deck",
          "count",
          "icon",
          "rules",
          "display"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "exploration",
              "event",
              "item"
            ]
          },
          "deck": {
            "$ref": "#/$defs/id"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "icon": {
            "$ref": "#/$defs/id"
          },
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timing",
              "effects"
            ],
            "properties": {
              "timing": {
                "$ref": "#/$defs/id"
              },
              "effects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "display": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "title",
              "body",
              "flavor"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "flavor": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
