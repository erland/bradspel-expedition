{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-cards.schema.json",
  "title": "Reference cards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reference_cards"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "reference_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "language",
          "source_ruleset",
          "template",
          "layout",
          "sections",
          "footer"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "source_ruleset": {
            "$ref": "#/$defs/id"
          },
          "template": {
            "type": "string",
            "pattern": "^.+\\.svg\\.j2$"
          },
          "layout": {
            "$ref": "#/$defs/id"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "source",
                "max_items"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "max_items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "footer": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
