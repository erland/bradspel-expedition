{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenarios.schema.json",
  "title": "Expedition scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scenarios"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "player_count",
          "solo_characters",
          "starting_resources",
          "setup",
          "endurance_phase",
          "fixed_location_rules",
          "victory",
          "defeat",
          "test_notes",
          "turn_order",
          "base_profile",
          "scenario_pack",
          "presentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "playtest_prototype"
          },
          "player_count": {
            "type": "object",
            "required": [
              "minimum",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "type": "integer",
                "minimum": 1
              },
              "maximum": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "solo_characters": {
            "type": "integer",
            "minimum": 1
          },
          "starting_resources": {
            "type": "object"
          },
          "setup": {
            "type": "object"
          },
          "location_resolution": {
            "type": "object"
          },
          "blocked_connection_rule": {
            "type": "object"
          },
          "assist_rule": {
            "type": "object"
          },
          "item_rule": {
            "type": "object"
          },
          "victory": {
            "type": "object"
          },
          "defeat": {
            "type": "object"
          },
          "test_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fixed_location_rules": {
            "type": "object"
          },
          "turn_order": {
            "type": "object"
          },
          "endurance_phase": {
            "type": "object"
          },
          "base_profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "scenario_pack": {
            "type": "string",
            "pattern": "^data/scenarios/.+/scenario\\.yaml$"
          },
          "presentation": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
