{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "selection",
    "defaults",
    "characters"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "selection": {
      "type": "object"
    },
    "defaults": {
      "type": "object"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "health",
          "backpack_capacity",
          "symbol",
          "ability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "health": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "backpack_capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "ability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timing",
              "effect",
              "text"
            ],
            "properties": {
              "timing": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
