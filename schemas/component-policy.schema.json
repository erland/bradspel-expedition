{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "principles",
        "base_components",
        "scenario_components"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "scenario_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "scope_model": {
      "type": "object"
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
