{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-event-deck.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scenario_event_deck"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scenario_event_deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "format_version",
        "name",
        "environment",
        "cards"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "symbol",
              "severity",
              "effect_type",
              "tags",
              "text",
              "effects"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "mild",
                  "medium",
                  "severe"
                ]
              },
              "effect_type": {
                "enum": [
                  "map_change",
                  "resource_change",
                  "immediate_choice"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "effects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "amount"
                      ],
                      "properties": {
                        "action": {
                          "const": "modify_endurance"
                        },
                        "amount": {
                          "type": "integer",
                          "not": {
                            "const": 0
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "connection_id"
                      ],
                      "properties": {
                        "action": {
                          "const": "open_connection"
                        },
                        "connection_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action",
                        "connection_id"
                      ],
                      "properties": {
                        "action": {
                          "const": "close_connection"
                        },
                        "connection_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        }
                      }
                    }
                  ]
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "format_version": {
          "type": "integer",
          "const": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "core",
                "environment",
                "scenario"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "level": {
                    "const": "core"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "id"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "level": {
                    "enum": [
                      "environment",
                      "scenario"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
