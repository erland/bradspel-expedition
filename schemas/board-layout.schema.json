{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-layout.schema.json",
  "title": "Board layout",
  "type": "object",
  "required": [
    "version",
    "layout",
    "palette",
    "style",
    "render"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "layout": {
      "type": "object",
      "required": [
        "id",
        "template",
        "width_mm",
        "height_mm",
        "safe_margin_mm"
      ],
      "additionalProperties": true
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "style": {
      "type": "object"
    },
    "render": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
