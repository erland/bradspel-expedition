{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "simulation",
    "strategies"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "simulation": {
      "type": "object",
      "required": [
        "scenario_id",
        "default_runs_per_strategy",
        "base_seed",
        "maximum_rounds",
        "characters_per_game",
        "output_directory",
        "assumptions",
        "metrics"
      ]
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "character_priority",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "character_priority": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  }
}
